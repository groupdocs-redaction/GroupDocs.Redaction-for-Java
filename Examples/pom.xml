<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>GroupDocs.Redaction-for-Java</groupId>
    <artifactId>GroupDocs.Redaction-for-Java</artifactId>
    <version>26.7</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <maven.compiler.release>8</maven.compiler.release>
        <maven.compiler.version>3.11.0</maven.compiler.version>
    </properties>

    <dependencies>
        <!-- Apache Commons Lang3 - Used in AsposeCloudOcrConnector -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.14.0</version>
        </dependency>

        <!-- Apache HttpClient - Used in MicrosoftAzureOcrConnector -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.14</version>
        </dependency>

        <!-- JSON library - Used in MicrosoftAzureOcrConnector -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
        </dependency>

        <!-- BouncyCastle - Used in MicrosoftAzureOcrConnector -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15on</artifactId>
            <version>1.70</version>
        </dependency>

        <!-- Aspose OCR Cloud SDK - Used in AsposeCloudOcrConnector -->
        <dependency>
            <groupId>com.aspose</groupId>
            <artifactId>aspose-ocr-cloud</artifactId>
            <version>21.6.0</version>
        </dependency>

        <!-- GroupDocs Redaction - Main library -->
        <dependency>
            <groupId>com.groupdocs</groupId>
            <artifactId>groupdocs-redaction</artifactId>
            <version>26.7</version>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>releases.aspose.cloud</id>
            <name>Aspose Cloud Releases</name>
            <url>https://releases.aspose.cloud/java/repo/</url>
        </repository>
        <repository>
            <id>releases.groupdocs.com</id>
            <name>GroupDocs Releases</name>
            <url>https://releases.groupdocs.com/java/repo/</url>
        </repository>
    </repositories>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.version}</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                    <showWarnings>true</showWarnings>
                    <showDeprecation>true</showDeprecation>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.groupdocs.redaction.examples.java.RunExamples</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
